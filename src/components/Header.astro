---
import { t, type Lang } from '../i18n/utils';
import { languages } from '../i18n/ui';

interface Props {
  lang: Lang;
  altHref: string;
  altLang: Lang;
}

const { lang, altHref, altLang } = Astro.props;
const tr = t(lang);
---

<header class="site-header" aria-label="Site header">
  <div class="header-inner">

    <a class="glass-pill pill-brand" href={lang === 'be' ? '/' : '/ru/'} aria-label={tr.brand.name}>
      <span class="brand-logo">
        <picture>
          <source srcset="/logo.avif" type="image/avif" />
          <img src="/logo.jpg" alt="" width="36" height="36" loading="eager" decoding="async" />
        </picture>
      </span>
      <span class="brand-text">
        <span class="brand-name">{tr.brand.name}</span>
        <span class="brand-tagline">{tr.brand.tagline}</span>
      </span>
    </a>

    <nav class="glass-pill pill-nav" aria-label="Main navigation">
      <a href="#benefits">{tr.nav.benefits}</a>
      <a href="#pricing">{tr.nav.pricing}</a>
      <a href="#contact">{tr.nav.contact}</a>
    </nav>

    <div class="glass-pill pill-actions">
      <a class="lang-switch" href={altHref} aria-label={tr.switcher.label} hreflang={altLang}>
        <span class="lang-current" aria-current="true">{languages[lang]}</span>
        <span class="lang-divider" aria-hidden="true">/</span>
        <span class="lang-alt">{languages[altLang]}</span>
      </a>
    </div>

  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 14px 20px;
    pointer-events: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
  }

  /* ── Liquid glass base ───────────────────────────────── */
  .glass-pill {
    pointer-events: all;
    position: relative;
    display: flex;
    align-items: center;
    border-radius: 999px;

    background: linear-gradient(
      158deg,
      rgba(255, 255, 255, 0.13) 0%,
      rgba(255, 255, 255, 0.04) 42%,
      rgba(10, 10, 14, 0.62) 100%
    );
    backdrop-filter: blur(28px) saturate(180%) brightness(108%);
    -webkit-backdrop-filter: blur(28px) saturate(180%) brightness(108%);

    border: 1px solid rgba(255, 255, 255, 0.14);
    border-top-color: rgba(255, 255, 255, 0.26);

    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      0 2px 8px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(0, 0, 0, 0.14);
  }

  /* Specular top-left gloss */
  .glass-pill::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      172deg,
      rgba(255, 255, 255, 0.17) 0%,
      rgba(255, 255, 255, 0.05) 38%,
      transparent 65%
    );
    pointer-events: none;
  }

  /* ── Brand pill ──────────────────────────────────────── */
  .pill-brand {
    gap: 10px;
    padding: 7px 16px 7px 7px;
    text-decoration: none;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      0 2px 8px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(0, 0, 0, 0.14),
      0 0 0 1px rgba(255, 122, 24, 0.1),
      0 0 28px -6px rgba(255, 122, 24, 0.22);
    transition: box-shadow 0.25s ease;
  }

  .pill-brand:hover {
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.5),
      0 2px 8px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.26),
      inset 0 -1px 0 rgba(0, 0, 0, 0.14),
      0 0 0 1px rgba(255, 122, 24, 0.24),
      0 0 44px -4px rgba(255, 122, 24, 0.38);
  }

  .brand-logo {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    overflow: hidden;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    flex: 0 0 auto;
  }

  .brand-logo picture {
    display: contents;
  }

  .brand-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    min-width: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .brand-tagline {
    font-size: 10px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-top: 2px;
  }

  /* ── Nav pill ────────────────────────────────────────── */
  .pill-nav {
    padding: 0 4px;
    gap: 0;
  }

  .pill-nav a {
    position: relative;
    padding: 10px 16px;
    font-size: 14px;
    color: var(--text-muted);
    border-radius: 999px;
    transition: color 0.18s ease, background 0.18s ease;
  }

  .pill-nav a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.07);
  }

  .pill-nav a::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 14px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    transition: transform 0.2s ease;
  }

  .pill-nav a:hover::after { transform: translateX(-50%) scaleX(1); }

  /* ── Actions pill ────────────────────────────────────── */
  .pill-actions {
    padding: 7px 4px;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border-radius: 999px;
    transition: color 0.18s ease, background 0.18s ease;
  }

  .lang-switch:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
  }

  .lang-current { color: var(--accent); }
  .lang-divider { color: var(--text-dim); }
  .lang-alt { color: var(--text-muted); }

  /* ── Mobile ──────────────────────────────────────────── */
  @media (max-width: 820px) {
    .pill-nav { display: none; }
    .brand-tagline { display: none; }
  }

  @media (max-width: 420px) {
    .site-header { padding: 10px 12px; }
    .pill-brand { padding: 6px 12px 6px 6px; }
  }
</style>